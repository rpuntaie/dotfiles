#!/usr/bin/env bash

if [ -z $1 ]; then
    llama-cli --reasoning-budget 0 -m $HOME/msrc/models_manually/gemma-4-12B-it-heretic-Q4_K_M.gguf
    exit
fi

if [[ $1 == "server" ]]; then
    taskset -c 8-16 llama-server --host 127.0.0.1 --port 8080 --models-preset $XDG_CONFIG_HOME/ai/llama.ini --models-max 1 --jinja --mcp-servers-config $XDG_CONFIG_HOME/ai/mcp.config.json -m $HOME/msrc/models_manually/gemma-4-12B-it-heretic-Q4_K_M.gguf -t 8 -np 2
    exit
fi

if [[ $1 == "list" ]]; then
    ollama list
    exit
fi

if [[ $1 == "llama" ]]; then
    mdl="llama3.1:8b"
elif [[ $1 == "qwen" ]]; then
    mdl="Qwen3:8B"
elif [[ $1 == "code" ]]; then
    mdl="codellama:7b-python"
else
    mdl="$1"
fi


if ! ollama run $mdl ; then
    (ollama serve &> /dev/null) &
    sleep 2
    ollama run $mdl
fi
