#!/usr/bin/env bash

CWD="$(pwd)"

SAN(){
cat > $CWD/selfsign.cnf <<EOF
[req]
distinguished_name = req_distinguished_name
x509_extensions = v3_req
prompt = no

[req_distinguished_name]
CN = localhost

[v3_req]
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
subjectAltName = @alt_names

[alt_names]
IP.1 = 127.0.0.1
DNS.1 = localhost
EOF
openssl req -x509 -nodes -days 365 -newkey rsa:2048 -keyout server.key -out server.crt -config $CWD/selfsign.cnf -extensions v3_req
}

localCA_mkcert(){
mkcert 127.0.0.1 localhost
}


: '
- generate a Certificate Authority (CA)
- generate your certfile (Server Certificate)
- abbreviations ST (stateOrProvinceName), C (countryName), L (localityName), O (organizationName)
- CN (commonName) and SAN (subjectAltName) for localhost or 127.0.0.1.

 | ca_certs | ca.crt     | Loaded by the client to trust the server.     |
 | certfile | server.crt | Loaded by the server to present its identity. |
 | keyfile  | server.key | Loaded by the server alongside the certfile.  |
'

localCA_openssl(){
cat > $CWD/selfsign.cnf <<EOF
[ req ]
default_bits       = 2048
default_md         = sha256
distinguished_name = req_distinguished_name
extensions         = v3_ca
req_extensions     = v3_req

[ req_distinguished_name ]
countryName                = Country Name (2 letter code)
countryName_default        = AT
stateOrProvinceName        = State or Province Name
stateOrProvinceName_default = Styria
localityName               = Locality Name
localityName_default       = Graz
organizationName           = Organization Name
organizationName_default   = Python Testing
commonName                 = Common Name
commonName_default         = localhost

[ v3_ca ]
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid:always,issuer
basicConstraints       = critical, CA:true
keyUsage               = critical, cRLSign, keyCertSign

[ v3_req ]
basicConstraints     = CA:FALSE
keyUsage             = critical, digitalSignature, keyEncipherment
extendedKeyUsage     = serverAuth, clientAuth
subjectAltName       = @alt_names

[ alt_names ]
DNS.1   = localhost
IP.1    = 127.0.0.1
EOF

## Step 1/2: Create the Local CA (Your ca_certs)
# Generate CA Private Key
openssl genrsa -out ca.key 2048
# Generate CA Root Certificate (Passes -extensions v3_ca)
openssl req -x509 -new -nodes -key ca.key -sha256 -days 365 -out ca.crt -config $CWD/selfsign.cnf -extensions v3_ca -subj "/CN=LocalTestCA"

## Step 2/2: Create the Server Certificate (Your certfile) [14]
# This generates a private key and a Certificate Signing Request (CSR) for your Python server, then signs it using your local CA. [15, 16, 17]
# Generate Server Private Key and CSR
openssl req -new -nodes -out server.csr -keyout server.key -config $CWD/selfsign.cnf -subj "/CN=localhost"
# Sign the CSR with your Local CA using the SAN extensions
openssl x509 -req -in server.csr -CA ca.crt -CAkey ca.key -CAcreateserial -out server.crt -days 365 -sha256 -extfile $CWD/selfsign.cnf -extensions v3_req
}



cat > $CWD/selfsign.cnf <<EOF
