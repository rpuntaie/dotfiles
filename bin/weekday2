#!/usr/bin/env python3

import sys
from datetime import date, datetime
if len(sys.argv) < 2:
    day = date.today()
else:
    x = sys.argv[1]
    day = date(int(x[:4]),int(x[4:6]),int(x[6:8]))
def yyyymmddwd(x):
    return f'{x.year}{x.month:02d}{x.day:02d}{"Mo Tu We Th Fr Sa Su".split()[x.weekday()]}'
print(yyyymmddwd(day))
