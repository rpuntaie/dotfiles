#!/usr/bin/env bash

# switch between us, de layouts or the one provided
: '
/usr/share/X11/locale/en_US.UTF-8/Compose
xmodmap -pke | grep "dead_acute"
grep -rn "dead_acute" /usr/share/X11/xkb/symbols
setxkbmap -print -verbose 10
grep "compose:" /usr/share/X11/xkb/rules/evdev.lst
xkbcomp $DISPLAY ~/tmp/current_layout.xkb

../etc/keymapper.conf
# must not have CapsLock mapped

./setesc
'

if [ -n "$1" ]; then
    setxkbmap $1
else
    layout=$(setxkbmap -query | grep layout | awk '{print $2}')
    case $layout in
        us)
            setxkbmap de
            ;;
        *)
            setxkbmap us
            ;;
    esac
fi

setxkbmap -option caps:swapescape,compose:rwin

exit 0
